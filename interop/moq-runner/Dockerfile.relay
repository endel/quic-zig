# syntax=docker/dockerfile:1
# Packages the binary interop/moq-runner/build_image.sh has already
# cross-compiled — do not `docker build` this directory directly.
#
# One relay for both transports: the runner dials https://relay:4443, but
# several clients use native QUIC (moqt-NN ALPN) on that port regardless.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates iproute2 \
 && rm -rf /var/lib/apt/lists/*

COPY bin/moq-relay /app/moq-relay
COPY entrypoint-relay.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh /app/moq-relay && mkdir -p /mlog /certs

RUN useradd -r -u 1000 -g nogroup moq
USER moq

ENV MOQT_ROLE=relay
ENV MOQT_PORT=4443
EXPOSE 4443/udp

HEALTHCHECK --interval=2s --timeout=2s --retries=15 \
  CMD ss -uln | grep -q ":${MOQT_PORT:-4443}"

ENTRYPOINT ["/app/entrypoint.sh"]
